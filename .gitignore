# ============================================================
#  目录约定
#    src/   开发目录 —— 源码 + 构建脚本（入库）
#    dist/  产物目录 —— dll / ini 入库，zip 不入库
#    re/    逆向分析产物 —— 一律不入库
# ============================================================

# ---- 编译中间产物 ----
*.obj
*.lib
*.exp
*.pdb
*.ilk
__pycache__/
*.pyc
/src/obj/

# ---- 构建输出 ----
*.exe
*.dll
!dist/dinput8.dll
/dist/*.zip

# ---- 逆向分析产物 ----
/re/
